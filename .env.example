# ==============================================================================
# MagickVoice Cypress Validations — Environment Configuration Template
# Copy this file to .env and provide your actual values (DO NOT commit .env)
# ==============================================================================

# Application Base URL (Frontend)
MV_APP_BASE_URL=https://staging.app.magickvoice.com

# Backend API Base URL
MV_API_BASE_URL=https://staging.appi.magickvoice.com

# Firebase Web API Key (From Firebase Console -> Project Settings -> General)
MV_FIREBASE_API_KEY=AIzaSy...your-firebase-web-api-key

# Dedicated Test User Credentials for Authentication Validations
MV_TEST_EMAIL=test-user@magickvoice.com
MV_TEST_PASSWORD=YourSecureTestPassword123!
